          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "lineageTag": "d2917e91-4c56-4493-990c-8ba2bfd2a814",
            "sourceColumn": "Quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "DefectRate_Pct",
            "dataType": "double",
            "formatString": "0.00%",
            "lineageTag": "b2ab20cb-dd65-47ac-93bf-d2097e801d43",
            "sourceColumn": "DefectRate_Pct",
            "summarizeBy": "sum"
          },
          {
            "name": "ShippingDelay_Days",
            "dataType": "int64",
            "lineageTag": "0c0c1177-d003-45cf-b222-9f8adacb504c",
            "sourceColumn": "ShippingDelay_Days",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "62bb4925-884e-4409-8acc-912f59a3ed0e",
        "measures": [
          {
            "name": "Total Revenue",
            "displayFolder": "Supply Chain & ESG",
            "expression": "SUMX(Fact_Orders, Fact_Orders[Quantity] * RELATED(Dim_Products[SalePrice]))",
            "formatString": "#,0.00",
            "lineageTag": "ec05777b-e897-497d-8140-c7a9ebb763d9"
          },
          {
            "name": "Total Cost",
            "displayFolder": "Supply Chain & ESG",
            "expression": "SUMX(Fact_Orders, Fact_Orders[Quantity] * RELATED(Dim_Products[UnitCost]))",
            "formatString": "#,0",
            "lineageTag": "bd669e87-3876-4a0c-933d-433c9873878f"
          },
          {
            "name": "Gross Profit",
            "displayFolder": "Supply Chain & ESG",
            "expression": "[Total Revenue] - [Total Cost]",
            "formatString": "#,0",
            "lineageTag": "dd685104-b88f-45c5-a442-ac0a2149381d"
          },
          {
            "name": "Gross Margin",
            "displayFolder": "Supply Chain & ESG",
            "expression": "DIVIDE([Gross Profit], [Total Revenue])",
            "formatString": "0.0%",
            "lineageTag": "56e4868d-1c24-4a0a-bd5f-4160c2a0839c"
          },
          {
            "name": "Total Quantity",
            "displayFolder": "Supply Chain & ESG",
            "expression": "SUM(Fact_Orders[Quantity])",
            "formatString": "#,0",
            "lineageTag": "5aa05d2f-0af8-4eb2-83e5-ddeb84d8b487"
          },
          {
            "name": "Order Count",
            "displayFolder": "Supply Chain & ESG",
            "expression": "COUNTROWS(Fact_Orders)",
            "formatString": "#,0",
            "lineageTag": "6119e38e-61f1-4917-9dd4-93cb7686bdb6"
          },
          {
            "name": "Active Suppliers",
            "displayFolder": "Supply Chain & ESG",
            "expression": "DISTINCTCOUNT(Fact_Orders[SupplierID])",
            "formatString": "0",
            "lineageTag": "2b90b89e-05ac-4528-b425-7346633bf012"
          },
          {
            "name": "Avg ESG Score",
            "displayFolder": "Supply Chain & ESG",
            "expression": "VAR IDs = VALUES(Fact_Orders[SupplierID]) RETURN CALCULATE(AVERAGE(Dim_Suppliers[ESG_Score]), TREATAS(IDs, Dim_Suppliers[SupplierID]))",
            "formatString": "0.0",
            "lineageTag": "a38b882e-b676-4f4c-950a-0116bac01c80"
          },
          {
            "name": "Carbon Footprint kg",
            "displayFolder": "Supply Chain & ESG",
            "expression": "SUMX(Fact_Orders, Fact_Orders[Quantity] * RELATED(Dim_Products[Carbon_Footprint_kg]))",
            "formatString": "#,0",
            "lineageTag": "266f331b-1641-4536-819a-c14dd141effb"
          },
          {
            "name": "Carbon Footprint t",
            "displayFolder": "Supply Chain & ESG",
            "expression": "DIVIDE([Carbon Footprint kg], 1000)",
            "formatString": "#,0.0",
            "lineageTag": "02b25222-d3b5-4cbf-a5a0-1170dd9aaa95"
          },
          {
            "name": "Critical Risk Suppliers",
            "displayFolder": "Supply Chain & ESG",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Orders[SupplierID]), KEEPFILTERS(Dim_Suppliers[Risk_Rating] = \"Critical\")) + 0",
            "formatString": "0",
            "lineageTag": "03ecd4fc-e105-4830-82a5-bcbf90b84bdb"
          },
          {
            "name": "High Risk Suppliers",
            "displayFolder": "Supply Chain & ESG",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Orders[SupplierID]), KEEPFILTERS(Dim_Suppliers[Risk_Rating] = \"High\")) + 0",
            "formatString": "0",
            "lineageTag": "c3411033-20de-4e1f-9de9-a59624920f84"
          },
          {
            "name": "Avg Shipping Delay",
            "displayFolder": "Supply Chain & ESG",
            "expression": "AVERAGE(Fact_Orders[ShippingDelay_Days])",
            "formatString": "0.0\" d\"",
            "lineageTag": "7ba05e8b-0152-43db-859f-bbed69dff54b"
          },
          {
            "name": "Estimated Defective Units",
            "displayFolder": "Supply Chain & ESG",
            "expression": "SUMX(Fact_Orders, Fact_Orders[Quantity] * Fact_Orders[DefectRate_Pct])",
            "formatString": "#,0",
            "lineageTag": "7048d540-1ade-42ec-8908-d12e2d6d0f04"
          },
          {
            "name": "Weighted Defect Rate",
            "displayFolder": "Supply Chain & ESG",
            "expression": "DIVIDE([Estimated Defective Units], [Total Quantity])",
            "formatString": "0.00%",
            "lineageTag": "0554eafb-fecc-420f-b806-02432d68d235"
          },
          {
            "name": "Supplier Defect Rank",
            "displayFolder": "Supply Chain & ESG",
            "expression": "VAR CurrentRate = [Weighted Defect Rate] VAR CurrentID = SELECTEDVALUE(Dim_Suppliers[SupplierID]) RETURN IF(NOT ISBLANK(CurrentRate), 1 + COUNTROWS(FILTER(ALLSELECTED(Dim_Suppliers), [Weighted Defect Rate] > CurrentRate || ([Weighted Defect Rate] = CurrentRate && Dim_Suppliers[SupplierID] < CurrentID))))",
            "formatString": "0",
            "lineageTag": "622c8d9f-15ac-4e84-bfc3-61a67b0155ad"
          },
          {
            "name": "ESG Score",
            "displayFolder": "Supply Chain & ESG",
            "expression": "AVERAGE(Dim_Suppliers[ESG_Score])",
            "formatString": "0.0",
            "lineageTag": "d1b81853-58df-4e1e-ae48-ba790d4f3713"
          },
          {
            "name": "Latest Data Date",
            "displayFolder": "Supply Chain & ESG",
            "expression": "CALCULATE(MAX(Fact_Orders[OrderDate]), REMOVEFILTERS())",
            "formatString": "dd mmm yyyy",
            "lineageTag": "86fc92cc-9a66-4010-80cd-8a0e51d9ac4e"
          },
          {
            "name": "Revenue 90D",
            "displayFolder": "Trends",
            "expression": "VAR AnchorDate = [Latest Data Date] RETURN IF(MAX(Calendar[Date]) > AnchorDate - 90 && MIN(Calendar[Date]) <= AnchorDate, [Total Revenue])",
            "formatString": "#,0",
            "lineageTag": "0adbdcfd-691d-49fb-b083-3f4d3e2c4432"
          },
          {
            "name": "ESG 90D",
            "displayFolder": "Trends",
            "expression": "VAR AnchorDate = [Latest Data Date] RETURN IF(MAX(Calendar[Date]) > AnchorDate - 90 && MIN(Calendar[Date]) <= AnchorDate, [Avg ESG Score])",
            "formatString": "0.0",
            "lineageTag": "e0d858ca-b69b-45f4-8daf-faacb0d9eca0"
          },
          {
            "name": "Carbon 90D",
            "displayFolder": "Trends",
            "expression": "VAR AnchorDate = [Latest Data Date] RETURN IF(MAX(Calendar[Date]) > AnchorDate - 90 && MIN(Calendar[Date]) <= AnchorDate, [Carbon Footprint t])",
            "formatString": "#,0",
            "lineageTag": "cefb5f10-46b5-4fe7-9601-a69ea4729765"
          },
          {
            "name": "Critical 90D",
            "displayFolder": "Trends",
            "expression": "VAR AnchorDate = [Latest Data Date] RETURN IF(MAX(Calendar[Date]) > AnchorDate - 90 && MIN(Calendar[Date]) <= AnchorDate, [Critical Risk Suppliers])",
            "formatString": "0",
            "lineageTag": "ecdb5757-f39e-429f-b21f-368df6cf6923"
          },
          {
            "name": "Defect History 12M",
            "displayFolder": "Trends",
            "expression": "VAR AnchorDate = [Latest Data Date] RETURN IF(MAX(Calendar[Date]) > EDATE(AnchorDate, -12) && MIN(Calendar[Date]) <= AnchorDate, [Weighted Defect Rate])",
            "formatString": "0.00%",
            "lineageTag": "dfbe3139-7cc1-40fc-b1a4-b346e229c7d4"
          },
          {
            "name": "Risk Color",
            "displayFolder": "Supply Chain & ESG",
            "expression": "SWITCH(SELECTEDVALUE(Dim_Suppliers[Risk_Rating]), \"Critical\", \"#FF4081\", \"High\", \"#FF879E\", \"Medium\", \"#00E5FF\", \"#39FF14\")",
            "lineageTag": "d8f7721b-7914-4e71-b267-fd7de289b328"
          },
          {
            "name": "KPI Sparkline 1",
            "dataCategory": "ImageUrl",
            "displayFolder": "Trends",
            "expression": [
              "VAR AnchorDate = [Latest Data Date]",
              "VAR StartDate = AnchorDate - 89",
              "VAR Days = CALCULATETABLE(VALUES('Calendar'[Date]), DATESBETWEEN('Calendar'[Date], StartDate, AnchorDate))",
              "VAR Points = FILTER(ADDCOLUMNS(Days, \"_Value\", CALCULATE([Total Revenue])), NOT ISBLANK([_Value]))",
              "VAR MinValue = MINX(Points, [_Value])",
              "VAR MaxValue = MAXX(Points, [_Value])",
              "VAR Coordinates = CONCATENATEX(Points, FORMAT(4 + DIVIDE('Calendar'[Date] - StartDate, 89) * 264, \"0.0\", \"en-US\") & \",\" & FORMAT(28 - IF(MaxValue = MinValue, 12, DIVIDE([_Value] - MinValue, MaxValue - MinValue) * 24), \"0.0\", \"en-US\"), \" \", 'Calendar'[Date], ASC)",
              "RETURN IF(COUNTROWS(Points) > 0, \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='274' height='34' viewBox='0 0 274 34'><polyline fill='none' stroke='%2300E5FF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' points='\" & Coordinates & \"'/></svg>\")"
            ],
            "lineageTag": "e2a5d6eb-54fa-430d-9171-a29006e752eb"
          },
          {
            "name": "KPI Sparkline 2",
            "dataCategory": "ImageUrl",
            "displayFolder": "Trends",
