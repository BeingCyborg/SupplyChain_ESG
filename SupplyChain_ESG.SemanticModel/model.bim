        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Dates = List.Dates(#date(2023,1,1), Duration.Days(#date(2026,12,31)-#date(2023,1,1))+1, #duration(1,0,0,0)),",
                "    T = Table.FromList(Dates, Splitter.SplitByNothing(), {\"Date\"}),",
                "    Typed = Table.TransformColumnTypes(T, {{\"Date\", type date}}),",
                "    Y = Table.AddColumn(Typed, \"Year\", each Date.Year([Date]), Int64.Type),",
                "    M = Table.AddColumn(Y, \"Month\", each Date.ToText([Date], \"MMM\"), type text),",
                "    MS = Table.AddColumn(M, \"MonthStart\", each Date.StartOfMonth([Date]), type date),",
                "    YM = Table.AddColumn(MS, \"YearMonth\", each Date.ToText([Date], \"yyyy-MM\"), type text)",
                "in",
                "    YM"
              ],
              "type": "m"
            }
          }
        ]
